# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...but the template must ship, or a fresh clone has nothing to copy from.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma (Phase 7). The dev database and the generated client are local artefacts.
/prisma/*.db
/prisma/*.db-journal
/lib/generated/

# Output of `pnpm test:live` — a real analysis, regenerated on demand.
live-report.txt

# Output of `pnpm test:quality` — regenerated on demand, costs credits.
quality-report.txt

# RuVector plugin scratch database — a local tool artefact, not part of the app.
ruvector.db

# Captured stdout from a live suite run - a measurement artefact, not source.
# before/after pairs land here when a prompt change is being measured; the
# numbers that matter get written into the README, the transcripts do not.
run.log
before.log
after.log
notes.log
notes2.log
notes3.log
