# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.

# ─── Provider selection ──────────────────────────────────────────────────────
# Which transport lib/ai uses: "nvidia" | "anthropic".
# The analysis logic — schema, rubric, prompt, retry, degraded path — is shared.
# Only the transport differs, so switching is a config change and a restart.
AI_PROVIDER=nvidia

# Model id for the selected provider. Never hardcoded in source.
#   nvidia    -> nvidia/nemotron-3-super-120b-a12b
#   anthropic -> claude-sonnet-5
AI_MODEL=nvidia/nemotron-3-super-120b-a12b

# ─── NVIDIA NIM (required when AI_PROVIDER=nvidia) ───────────────────────────
# Free key from https://build.nvidia.com — free tier allows 40 req/min per model.
NVIDIA_API_KEY=

# Override only to point at a self-hosted NIM container.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Nemotron 3 Super is a reasoning model whose thinking can be toggled.
# Left off deliberately: measured at 7s vs 129s per analysis with no score
# difference, and thinking-on returned an empty answer often enough to cost a
# retry. Reasoning arrives on a separate reasoning_content field either way, so
# this never affects JSON parsing. See the README for the numbers.
# NVIDIA_ENABLE_THINKING=false
# NVIDIA_REASONING_BUDGET=4096

# ─── Anthropic (required when AI_PROVIDER=anthropic) ─────────────────────────
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_EFFORT=medium

# ─── Shared model tuning ─────────────────────────────────────────────────────
# Low for repeatability. Note: measured effect on Nemotron is small — the rubric
# anchors and the injected measured counts do more for score stability.
# AI_TEMPERATURE=0.2
# Generous: the analysis JSON is large. Floored at 4000 by validation.
# AI_MAX_TOKENS=16384
# 50s, per request. Picked from measured latency: across eighteen live calls the
# slowest request that SUCCEEDED took 43.6s and the second slowest 25.1s.
# The ceiling is the route's maxDuration of 120s, which must cover the whole
# worst case: 2 attempts x 50s + 5s of extraction and serialisation = 105s.
# Raise this past ~57s and a slow request is killed by the platform instead of
# degrading to the structural report. A test asserts the arithmetic.
# AI_TIMEOUT_MS=50000

# ─── Persistence ─────────────────────────────────────────────────────────────
# "session" needs no database. "db" enables cross-session history via Prisma.
PERSISTENCE=session
# Must be NEXT_PUBLIC_: the store is chosen in the browser, and a server-only
# variable reads as undefined there and silently pins everyone to session mode.
NEXT_PUBLIC_PERSISTENCE=session
DATABASE_URL=file:./prisma/dev.db
